{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vizora",
  "version": "0.1.0",
  "identifier": "com.zayeedbinkabir.vizora",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/copy-web.mjs",
    "beforeBuildCommand": "node scripts/copy-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vizora",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Open-source BI studio",
    "longDescription": "Tableau-style drag-and-drop charts and Power BI-style dashboards with calculated fields and joins. Your data stays on your computer.",
    "copyright": "© 2026 Zayeed Bin Kabir. MIT License.",
    "publisher": "Zayeed Bin Kabir",
    "homepage": "https://vizora.zayeedbinkabir.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
